# Supabase Configuration
# Masukkan URL dan ANON Key dari Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode Demo / Mock Offline (true = gunakan local storage & mock backend jika belum menghubungkan Supabase)
VITE_USE_MOCK_DATA=true
